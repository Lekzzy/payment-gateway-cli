# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# API Configuration
API_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Authentication
# Provide either a single API key or a comma-separated list of keys.
# The server expects header: Authorization: Bearer <API_KEY>
# If both are provided, both are allowed.
API_KEY=your_single_api_key_here
API_KEYS=key1,key2,key3

# Blockchain Configuration
RPC_URL=https://rpc-amoy.polygon.technology
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com

# Private Keys (NEVER COMMIT REAL PRIVATE KEYS)
PRIVATE_KEY=your_private_key_here
AMOY_PRIVATE_KEY=your_amoy_private_key_here

# Contract Configuration
TRUSTED_SIGNER=0x0000000000000000000000000000000000000000
PLATFORM_TREASURY=0x0000000000000000000000000000000000000000
PLATFORM_FEE_BPS=100

# Verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Gas Configuration
GAS_PRICE=60000000000
GAS_LIMIT=5000000
