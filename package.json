{
  "name": "@billing/payment-gateway-cli",
  "version": "1.0.0",
  "description": "Payment gateway CLI tool and SDK for billing system integrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "billing": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "api:dev": "ts-node src/api/index.ts",
    "api:start": "node dist/api/index.js",
    "api:build": "tsc && node dist/api/index.js",
    "test:api": "ts-node src/api/test-index.ts",
    "test:api:build": "tsc && node dist/api/test-index.js",
    "discord:listen": "ts-node -e \"import('./src/discord/webhook-listener').then(m => m.DiscordWebhookListener)\"",
    "discord:test": "billing discord test",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "billing",
    "payment",
    "gateway",
    "cli",
    "sdk",
    "discord",
    "webhooks"
  ],
  "author": "Dev 2",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^7.1.0",
    "inquirer": "^8.2.6",
    "rimraf": "^6.0.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@zerollup/ts-transform-paths": "^1.7.18",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "ttypescript": "^1.5.15",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/billing/payment-gateway-cli.git"
  }
}
